# SmartSchedule AI Environment Configuration

# Database Configuration:
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# For zero-config local run: sqlite:///./smartschedule.db
DATABASE_URL=sqlite:///./smartschedule.db

# MySQL Settings (Optional if using DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DB=smartschedule_ai

# Security & sessions
# Generate a persistent key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_persistent_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REMEMBER_ME_EXPIRE_DAYS=7
COOKIE_SECURE=false
LOGIN_RATE_LIMIT=5
OTP_EXPIRE_MINUTES=10
TRUSTED_DEVICE_EXPIRE_DAYS=30

# Bootstrap administrator. Set a real email and a unique password (12+ characters).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=System Administrator

# Demo-only authentication bypasses. Keep disabled for production.
DEMO_SIGNUP_ENABLED=false
DEMO_LOGIN_ENABLED=false

# SMTP is required for verification codes, account setup, and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional External AI API Key (Chatbot has built-in grounded DB engine)
GEMINI_API_KEY=
OPENAI_API_KEY=
